# NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5

# RUN: llc -mtriple=amdgcn -mcpu=gfx942 -start-after=si-peephole-sdwa -o - %s | FileCheck %s

# Change defining instruction of %4 to use %1 instead of %0.
# This is justified since the instruction uses only the half of the register which
# is preserved. This seems like a generally valid optimization. That is, rewrite an instruction I
# to use the last register in a chain of instructions preserving the part of the register
# used by instruction I.

# In this example, I have executed this transformation separately in this and the following step.
# But I think that it would make more sense to do this in one by walking the chain of dst_unused:UNUSED_PRESERVE
# instructions.


--- |

  define amdgpu_kernel void @symmetric_equal_edges_fp16 {
  ; CHECK-LABEL: symmetric_equal_edges_fp16:
  ; CHECK:       ; %bb.0:
  ; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
  ; CHECK-NEXT:    v_mov_b32_e32 v2, 0x3118
  ; CHECK-NEXT:    v_mul_f16_sdwa v0, v0, v2 dst_sel:WORD_0 dst_unused:UNUSED_PRESERVE src0_sel:WORD_0 src1_sel:DWORD
  ; CHECK-NEXT:    s_nop 0
  ; CHECK-NEXT:    v_mov_b32_e32 v1, v0
  ; CHECK-NEXT:    v_sin_f16_sdwa v1, v1 dst_sel:WORD_0 dst_unused:UNUSED_PRESERVE src0_sel:WORD_0
  ; CHECK-NEXT:    s_nop 0
  ; CHECK-NEXT:    v_mul_f16_sdwa v1, v0, v2 dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1 src1_sel:WORD_0
  ; CHECK-NEXT:    s_nop 0
  ; CHECK-NEXT:    v_sin_f16_sdwa v1, v1 dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1
  ; CHECK-NEXT:    s_nop 0
  ; CHECK-NEXT:    v_mov_b32_e32 v0, v1
  ; CHECK-NEXT:    s_setpc_b64 s[30:31]
  ret void
  }

...
---
name: symmetric_equal_edges_fp16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0


    %0:vgpr_32 = COPY $vgpr0
    %8:vgpr_32 = V_MOV_B32_e32 12568, implicit $exec
    %1:vgpr_32 = nofpexcept V_MUL_F16_sdwa 0, %0, 0, %8, 0, 0, 4, 2, 4, 6, implicit $mode, implicit $exec, implicit %0(tied-def 0)
    %2:vgpr_32 = nofpexcept V_SIN_F16_sdwa 0, %1, 0, 0, 4, 2, 4, implicit $mode, implicit $exec, implicit %1(tied-def 0)
    %7:vgpr_32 = V_MOV_B32_e32 12568, implicit $exec
    %4:vgpr_32 = nofpexcept V_MUL_F16_sdwa 0, %1, 0, %7, 0, 0, 5, 2, 5, 4, implicit $mode, implicit $exec, implicit %2(tied-def 0)
    %5:vgpr_32 = nofpexcept V_SIN_F16_sdwa 0, killed %4, 0, 0, 5, 2, 5, implicit $mode, implicit $exec, implicit killed %4(tied-def 0)
    $vgpr0 = COPY %5
    SI_RETURN implicit $vgpr0
...

