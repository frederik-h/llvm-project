# NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5

# RUN: llc -mtriple=amdgcn -mcpu=gfx942 -start-after=si-peephole-sdwa -o - %s | FileCheck %s

# Apply new VPACK replacement:
# Turn instructions defining operands of the VPACK into SDWA using dst_unused:UNUSED_PRESERVE.
# This is valid since operands are known to write to one half of the register only.

--- |

  define amdgpu_kernel void @symmetric_equal_edges_fp16() {
  ; CHECK-LABEL: symmetric_equal_edges_fp16:
  ; CHECK:       ; %bb.0:
  ; CHECK-NEXT:    s_waitcnt vmcnt(0) expcnt(0) lgkmcnt(0)
  ; CHECK-NEXT:    v_mul_f16_e32 v1, 0.15915494, v0
  ; CHECK-NEXT:    v_sin_f16_e32 v1, v1
  ; CHECK-NEXT:    v_mov_b32_e32 v2, 0x3118
  ; CHECK-NEXT:    v_mul_f16_sdwa v1, v0, v2 dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1 src1_sel:WORD_0
  ; CHECK-NEXT:    s_nop 0
  ; CHECK-NEXT:    v_sin_f16_sdwa v1, v1 dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1
  ; CHECK-NEXT:    s_nop 0
  ; CHECK-NEXT:    v_mov_b32_e32 v0, v1
  ; CHECK-NEXT:    s_setpc_b64 s[30:31]
  ret void
  }

...
---
name: symmetric_equal_edges_fp16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0


    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = nofpexcept V_MUL_F16_e64 0, %0, 0, 12568, 0, 0, implicit $mode, implicit $exec
    %2:vgpr_32 = nofpexcept V_SIN_F16_e64 0, killed %1, 0, 0, implicit $mode, implicit $exec
    %7:vgpr_32 = V_MOV_B32_e32 12568, implicit $exec
    %4:vgpr_32 = nofpexcept V_MUL_F16_sdwa 0, %0, 0, %7, 0, 0, 5, 2, 5, 4, implicit $mode, implicit $exec, implicit %2(tied-def 0)
    %5:vgpr_32 = nofpexcept V_SIN_F16_sdwa 0, killed %4, 0, 0, 5, 2, 5, implicit $mode, implicit $exec, implicit killed %4(tied-def 0)
    $vgpr0 = COPY %5
    SI_RETURN implicit $vgpr0
...

