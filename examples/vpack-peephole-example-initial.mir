---
name: symmetric_equal_edges_fp16
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = nofpexcept V_MUL_F16_e64 0, %0, 0, 12568, 0, 0, implicit $mode, implicit $exec
    %2:vgpr_32 = nofpexcept V_SIN_F16_e64 0, killed %1, 0, 0, implicit $mode, implicit $exec
    %3:vgpr_32 = V_LSHRREV_B32_e64 16, %0, implicit $exec
    %4:vgpr_32 = nofpexcept V_MUL_F16_e64 0, %3, 0, 12568, 0, 0, implicit $mode, implicit $exec
    %5:vgpr_32 = nofpexcept V_SIN_F16_e64 0, killed %4, 0, 0, implicit $mode, implicit $exec
    %6:vgpr_32 = nofpexcept V_PACK_B32_F16_e64 0, killed %2, 0, killed %5, 0, 0, implicit $mode, implicit $exec
    $vgpr0 = COPY %6
    SI_RETURN implicit $vgpr0
