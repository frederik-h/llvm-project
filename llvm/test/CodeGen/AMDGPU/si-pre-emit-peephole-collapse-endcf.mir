# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-pre-emit-peephole -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu9.00 -passes=si-pre-emit-peephole -verify-machineinstrs %s -o - | FileCheck %s

# SILowerControlFlow marks EXEC restores which are followed by a full mask
# restore without any instruction reading EXEC in between as S_OR_B64_endcf.
# They are removed by SIPreEmitPeephole if no EXEC users have been added.

---
name: skip_salu_and_meta_insts_find_first
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: skip_salu_and_meta_insts_find_first
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr4_sgpr5, $sgpr6_sgpr7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0_sgpr1 = S_AND_SAVEEXEC_B64 $sgpr4_sgpr5, implicit-def $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   S_CBRANCH_EXECZ %bb.4, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0_sgpr1, $sgpr6_sgpr7
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr2_sgpr3 = S_AND_SAVEEXEC_B64 $sgpr6_sgpr7, implicit-def $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2_sgpr3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2_sgpr3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr8 = IMPLICIT_DEF
  ; CHECK-NEXT:   $sgpr9 = S_BREV_B32 $sgpr8
  ; CHECK-NEXT:   KILL $sgpr8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $exec = S_OR_B64 $exec, $sgpr0_sgpr1, implicit-def dead $scc
  ; CHECK-NEXT:   GLOBAL_STORE_DWORD undef $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.4
    liveins: $vgpr0, $sgpr4_sgpr5, $sgpr6_sgpr7

    $sgpr0_sgpr1 = S_AND_SAVEEXEC_B64 $sgpr4_sgpr5, implicit-def $exec, implicit-def dead $scc, implicit $exec
    S_CBRANCH_EXECZ %bb.4, implicit $exec

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr6_sgpr7

    $sgpr2_sgpr3 = S_AND_SAVEEXEC_B64 $sgpr6_sgpr7, implicit-def $exec, implicit-def dead $scc, implicit $exec
    S_CBRANCH_EXECZ %bb.3, implicit $exec

  bb.2:
    successors: %bb.3
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2_sgpr3

  bb.3:
    successors: %bb.4
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2_sgpr3

    $exec = S_OR_B64_endcf $exec, $sgpr2_sgpr3, implicit-def dead $scc
    $sgpr8 = IMPLICIT_DEF
    $sgpr9 = S_BREV_B32 $sgpr8
    KILL $sgpr8

  bb.4:
    liveins: $vgpr0, $sgpr0_sgpr1

    $exec = S_OR_B64 $exec, $sgpr0_sgpr1, implicit-def dead $scc
    GLOBAL_STORE_DWORD undef $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
    S_ENDPGM 0
...

