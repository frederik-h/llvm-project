# In wave64, an S_OR_B32 to exec_lo is only a partial exec update. It must not
# make a preceding restore redundant.
---
name: wave64_exec_lo_partial_restore
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2

    ; CHECK-LABEL: name: wave64_exec_lo_partial_restore
    ; CHECK: liveins: $vgpr0, $sgpr0_sgpr1, $sgpr2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $exec = S_OR_B64 $exec, $sgpr0_sgpr1, implicit-def dead $scc
    ; CHECK-NEXT: $exec_lo = S_OR_B32 $exec_lo, $sgpr2, implicit-def dead $scc
    ; CHECK-NEXT: GLOBAL_STORE_DWORD undef $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $exec = S_OR_B64_endcf $exec, $sgpr0_sgpr1, implicit-def dead $scc
    $exec_lo = S_OR_B32 $exec_lo, $sgpr2, implicit-def dead $scc
    GLOBAL_STORE_DWORD undef $vgpr2_vgpr3, $vgpr0, 0, 0, implicit $exec
    S_ENDPGM 0
...

